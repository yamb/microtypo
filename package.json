{
  "name": "yamb-microtypo",
  "version": "0.1.2",
  "description": "Bounded MicroTypo typography for Yamb HTML preparation",
  "keywords": [
    "russian",
    "typography",
    "yamb"
  ],
  "license": "MIT",
  "author": {
    "name": "Alexey Simonenko",
    "email": "alexey@simonenko.dev",
    "url": "https://simonenko.xyz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yamb/microtypo.git"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "node scripts/run-tests.mjs",
    "test:watch": "node --test --watch 'test/**/*.test.js'"
  },
  "dependencies": {
    "microtypo": "^0.4.1"
  },
  "devDependencies": {
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "packageManager": "pnpm@12.23.0"
}
